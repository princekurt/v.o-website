# Site
# No paid domain required: use the free Vercel production URL.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Option A: Resend email delivery (requires a verified sending domain)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Villanueva Ong Electrical Lights Trading <quotes@your-domain.com>"
LEADS_EMAIL=villanuevaongtrading@gmail.com

# Option B: lead webhook. If set, the form works even without Resend.
# Formspree free tier example: https://formspree.io/f/your-form-id
LEADS_WEBHOOK_URL=

# Optional: Google Search Console meta verification
GOOGLE_SITE_VERIFICATION=
